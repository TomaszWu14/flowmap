# --- local development (flask run) ---
# APP_ENV=development
# SECRET_KEY=change-me
# DATABASE_URL=sqlite:///flowmap.db          # default; file lands in instance/
ALLOW_SIGNUP=true
# COOKIE_SECURE=false                         # true by default when APP_ENV=production

# --- AI (optional; without a key FlowMap runs on rules and templates) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=60
AI_DAILY_LIMIT=100

# --- docker compose (local). Coolify generates these two automatically. ---
# Use hex only: characters like / + @ break DATABASE_URL.
#   SERVICE_HEX_32_POSTGRES=$(openssl rand -hex 32)
#   SERVICE_PASSWORD_64_SECRETKEY=$(openssl rand -hex 32)
SERVICE_HEX_32_POSTGRES=
SERVICE_PASSWORD_64_SECRETKEY=
